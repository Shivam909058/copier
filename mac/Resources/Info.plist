<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>dev.copier.mac</string>
    <key>CFBundleName</key>
    <string>Copier</string>
    <key>CFBundleDisplayName</key>
    <string>Copier</string>
    <key>CFBundleExecutable</key>
    <string>Copier</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Copier talks to your paired Android phone on this network to sync the clipboard and files.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_copier._tcp</string>
    </array>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Send to Phone</string>
            </dict>
            <key>NSMessage</key>
            <string>sendToPhone</string>
            <key>NSPortName</key>
            <string>Copier</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
            </array>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Open on Phone</string>
            </dict>
            <key>NSMessage</key>
            <string>openOnPhoneService</string>
            <key>NSPortName</key>
            <string>Copier</string>
            <key>NSRequiredContext</key>
            <dict/>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
                <string>public.url</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
