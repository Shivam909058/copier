<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share target: the dynamic "Send to <Mac>" shortcut (publishShareShortcut) opens ShareActivity. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="dev.copier.ShareActivity">
        <data android:mimeType="*/*" />
        <category android:name="dev.copier.category.SEND_TO_MAC" />
    </share-target>
</shortcuts>
